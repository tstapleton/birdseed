{
  "name": "birdseed",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:plotline": "PLOTLINE=1 jest",
    "plotline:report": "plotline report plotline --out plotline/report"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/forms": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "@angular/router": "20.3.34",
    "@ngrx/signals": "20.1.0",
    "@tstapleton/plotline": "0.1.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.41",
    "@angular/cli": "20.3.41",
    "@angular/compiler-cli": "20.3.34",
    "@angular/platform-browser-dynamic": "20.3.34",
    "@testing-library/angular": "18.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.8",
    "@types/jest": "30.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-preset-angular": "15.0.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
